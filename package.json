{
  "name": "matthew-ui",
  "version": "0.2.0",
  "description": "A typed React UI component library with Button, Menu, and AutoComplete.",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui-components",
    "typescript"
  ],
  "homepage": "https://github.com/bingomaha-creator/Matthew-ui#readme",
  "bugs": {
    "url": "https://github.com/bingomaha-creator/Matthew-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingomaha-creator/Matthew-ui.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.cjs"
    },
    "./button/style.css": "./dist/button/style.css",
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js",
      "require": "./dist/menu/index.cjs"
    },
    "./menu/style.css": "./dist/menu/style.css",
    "./auto-complete": {
      "types": "./dist/auto-complete/index.d.ts",
      "import": "./dist/auto-complete/index.js",
      "require": "./dist/auto-complete/index.cjs"
    },
    "./auto-complete/style.css": "./dist/auto-complete/style.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "vite build && npm run build:types && npm run build:styles",
    "build:styles": "node scripts/build-styles.mjs",
    "build:types": "rollup --config rollup.dts.config.mjs",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts .storybook vite.config.ts vitest.config.ts",
    "test": "vitest --project=unit",
    "test:run": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook",
    "test:all": "npm run test:run && npm run test:stories",
    "test:package-checks": "npm run build && node --test scripts/package-verification/*.test.mjs",
    "verify:package": "npm run test:package-checks && node scripts/verify-package.mjs",
    "quality:check": "npm run typecheck && npm run lint && npm run test:all && npm run build-storybook && npm run verify:package",
    "release:check": "node scripts/check-release.mjs && npm run quality:check",
    "release:dry-run": "npm publish --dry-run --access public",
    "prepublishOnly": "npm run release:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "sass": "^1.102.0",
    "storybook": "^10.5.9",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
